# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/database
# ^ TiDB Cloud or MySQL connection string

# ── BETTER AUTH ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# ^ Generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# ^ For production: https://joindot.africa

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── APP URL ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# ^ For production: https://joindot.africa

# ── LEGACY (for migration) ────────────────────────────────────────────────────
OWNER_UNION_ID=

# ── PAYSTACK ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# ── STRIPE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WHOP ──────────────────────────────────────────────────────────────────────
WHOP_API_KEY=whop_...
NEXT_PUBLIC_WHOP_PRODUCT_ID=prod_...
WHOP_PLAN_STARTER=plan_...
WHOP_PLAN_VIP=plan_...
WHOP_PLAN_PIONEER=plan_...
WHOP_PLAN_CORPORATE=plan_...
WHOP_PLAN_HUB=plan_...

# ── CLOUDFLARE R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=dot-assets
R2_PUBLIC_URL=https://assets.joindot.africa

# ── RESEND (EMAIL) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=hello@joindot.africa

# ── TWILIO / WHATSAPP ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_...
TWILIO_AUTH_TOKEN=...
WHATSAPP_FROM_NUMBER=+1415...

# ── POSTHOG ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── UPSTASH (RATE LIMITING) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── APP ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://joindot.africa
MAY_29_EVENT_ID=

# ── CRON SECRET ────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-key
